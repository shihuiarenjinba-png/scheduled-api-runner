{
  "root_dir": "./scheduled-work",
  "allow_hosts": [
    "api.example.com"
  ],
  "poll_seconds": 30,
  "state_db": ".state/scheduler.sqlite3",
  "log_path": "logs/api.jsonl",
  "jobs": [
    {
      "name": "Daily sales time series",
      "enabled": false,
      "schedule": {
        "type": "daily",
        "at": "09:00"
      },
      "retries": 0,
      "request": {
        "method": "GET",
        "url": "https://api.example.com/sales/daily",
        "headers": {
          "Authorization": "${ENV:SALES_API_AUTH}"
        },
        "timeout_seconds": 20
      },
      "csv_update": {
        "path": "history/daily-sales.csv",
        "fields": "sales = data.sales\norders = data.orders",
        "date_path": "data.date",
        "on_duplicate": "skip"
      }
    }
  ]
}
